## MOBILE (logos_app) ##

# Generated l10n dart files (regenerated by flutter gen-l10n from .arb sources)
/logos_app/lib/config/l10n/arb/app_localizations*.dart

# Flutter/Dart
/logos_app/.dart_tool/
/logos_app/.flutter-plugins-dependencies
/logos_app/.flutter-plugins
/logos_app/.packages
/logos_app/.pub-cache/
/logos_app/.pub/
/logos_app/build/
/logos_app/coverage/
/logos_app/**/doc/api/
/logos_app/**/ios/Flutter/.last_build_id
/logos_app/app.*.symbols
/logos_app/app.*.map.json
/logos_app/android/.kotlin/

# Optional environment + editor files
/logos_app/.vscode/
/logos_app/.idea/
/logos_app/*.iml
/logos_app/*.ipr
/logos_app/*.iws

# OS/temp
/logos_app/**/.DS_Store
/logos_app/**/.log
/logos_app/**/.swp
/logos_app/**/.class
/logos_app/**/.pyc
/logos_app/**/.svn/
/logos_app/**/.history
/logos_app/**/.swiftpm/
/logos_app/migrate_working_dir/

## BACKEND (logos_backend) ##

# Gradle/kotlin
/logos_backend/.gradle/
/logos_backend/build/
/logos_backend/.kotlin/
/logos_backend/nbproject/
/logos_backend/nbbuild/
logos_backend/dist/
logos_backend/nbdist/

# IDEs
/logos_backend/.idea/
/logos_backend/.vscode/
/logos_backend/*.iml
/logos_backend/*.ipr
/logos_backend/*.iws
/logos_backend/.classpath
/logos_backend/.project
/logos_backend/.settings
/logos_backend/.factorypath
/logos_backend/.apt_generated
/logos_backend/.springBeans
/logos_backend/.sts4-cache

# Keep wrapper jar tracked when needed
!logos_backend/gradle/wrapper/gradle-wrapper.jar

# Keep source build outputs per-module, but ignore module final outputs
/logos_backend/**/build/
/logos_backend/**/bin/
logos_backend/**/out/

# Full-repo settings
/.idea/
/.vscode/*
!/.vscode/launch.json
*.iml
*.ipr
*.iws
